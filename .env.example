# --- required ---
DATABASE_URL="postgresql://synapse:synapse@localhost:5433/synapse?schema=public"
# Public base URL, used in emails and OAuth redirects
APP_URL="http://localhost:3000"

# --- optional: Google sign-in (button hidden when unset) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- optional: real email via Resend (emails go to /dev/mailbox when unset) ---
RESEND_API_KEY=""
EMAIL_FROM="SYNAPSE <hello@example.com>"

# --- optional: Stripe (mock checkout is used when unset, never in production) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PREMIUM_PRICE_ID=""

# --- tests (vitest uses a separate database) ---
TEST_DATABASE_URL="postgresql://synapse:synapse@localhost:5433/synapse_test?schema=public"

# --- optional: public demo deployment (one-click /demo accounts; keeps the test checkout on) ---
DEMO_MODE=""
